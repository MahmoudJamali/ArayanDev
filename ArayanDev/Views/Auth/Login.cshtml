@{
    ViewData["Title"] = "ورود";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>ورود یا ثبت نام | آکادمی آرایان</title>

    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            font-family: "Vazirmatn", Tahoma, sans-serif;
            color: #fff;
            background: radial-gradient( circle at 20% 20%, rgba(0, 240, 255, 0.08), transparent 35% ), radial-gradient( circle at 80% 80%, rgba(255, 0, 212, 0.08), transparent 35% ), #070b14;
            position: relative;
            overflow: hidden;
        }


            /* ==========================
                   Background Grid
                ========================== */

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background-image: linear-gradient( rgba(255,255,255,0.025) 1px, transparent 1px ), linear-gradient( 90deg, rgba(255,255,255,0.025) 1px, transparent 1px );
                background-size: 50px 50px;
                mask-image: linear-gradient( to bottom, black, transparent 90% );
                pointer-events: none;
            }


        /* ==========================
                   Glow Orbs
                ========================== */

        .login-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            pointer-events: none;
            opacity: .35;
        }

        .login-orb-1 {
            width: 300px;
            height: 300px;
            background: #00f0ff;
            top: -120px;
            left: -100px;
        }

        .login-orb-2 {
            width: 280px;
            height: 280px;
            background: #ff00d4;
            bottom: -120px;
            right: -100px;
        }


        /* ==========================
                   Login Wrapper
                ========================== */

        .login-wrapper {
            width: 100%;
            max-width: 430px;
            position: relative;
            z-index: 2;
            animation: loginAppear .7s ease-out;
        }

        @@keyframes loginAppear {
            from {
                opacity: 0;
                transform: translateY(30px) scale(.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }


        /* ==========================
                   Brand
                ========================== */

        .login-brand {
            text-align: center;
            margin-bottom: 25px;
        }

        .login-logo {
            width: 62px;
            height: 62px;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,240,255,.35);
            border-radius: 18px;
            background: linear-gradient( 135deg, rgba(0,240,255,.08), rgba(255,0,212,.08) );
            box-shadow: 0 0 25px rgba(0,240,255,.10), inset 0 0 20px rgba(255,255,255,.02);
        }

            .login-logo svg {
                width: 42px;
                height: 42px;
            }

        .login-brand h2 {
            margin: 0;
            font-size: 21px;
            letter-spacing: 2px;
            font-weight: 700;
            background: linear-gradient( 90deg, #00f0ff, #fff, #ff00d4 );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .login-brand p {
            margin: 6px 0 0;
            color: rgba(255,255,255,.45);
            font-size: 12px;
            letter-spacing: 1px;
        }


        /* ==========================
                   Login Card
                ========================== */

        .login-card {
            width: 100%;
            padding: 38px 32px 32px;
            border-radius: 22px;
            background: linear-gradient( 145deg, rgba(255,255,255,.055), rgba(255,255,255,.018) );
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 30px 80px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            position: relative;
            overflow: hidden;
        }

            .login-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 10%;
                right: 10%;
                height: 1px;
                background: linear-gradient( 90deg, transparent, #00f0ff, #ff00d4, transparent );
                opacity: .8;
            }


            /* ==========================
                   Title
                ========================== */

            .login-card h3 {
                margin: 0 0 10px;
                text-align: center;
                font-size: 24px;
                font-weight: 700;
                color: #fff;
            }

        .login-description {
            margin: 0 0 30px;
            text-align: center;
            color: rgba(255,255,255,.48);
            font-size: 13px;
            line-height: 2;
        }


        /* ==========================
                   Input
                ========================== */

        .input-group-custom {
            position: relative;
        }

        .input-label {
            display: block;
            margin-bottom: 9px;
            color: rgba(255,255,255,.75);
            font-size: 13px;
            font-weight: 500;
            text-align: right;
        }

        .phone-input {
            width: 100%;
            height: 52px;
            border-radius: 13px;
            border: 1px solid rgba(255,255,255,.11);
            background: rgba(0,0,0,.20);
            color: #fff;
            padding: 0 16px;
            font-family: "Vazirmatn", Tahoma, sans-serif;
            font-size: 14px;
            text-align: center;
            outline: none;
            transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
        }

            .phone-input::placeholder {
                color: rgba(255,255,255,.30);
            }

            .phone-input:focus {
                border-color: rgba(0,240,255,.65);
                background: rgba(0,240,255,.035);
                box-shadow: 0 0 0 3px rgba(0,240,255,.08), 0 0 25px rgba(0,240,255,.08);
            }


        /* ==========================
                   Send Button
                ========================== */

        .send-btn {
            width: 100%;
            height: 52px;
            margin-top: 22px;
            border: 1px solid rgba(0,240,255,.35);
            border-radius: 13px;
            background: linear-gradient( 90deg, rgba(0,240,255,.13), rgba(255,0,212,.13) );
            color: #fff;
            font-family: "Vazirmatn", Tahoma, sans-serif;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

            .send-btn::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 90deg, transparent, rgba(255,255,255,.12), transparent );
                transform: translateX(-100%);
                transition: transform .5s ease;
            }

            .send-btn:hover {
                transform: translateY(-2px);
                border-color: rgba(0,240,255,.7);
                box-shadow: 0 8px 30px rgba(0,240,255,.12), 0 8px 30px rgba(255,0,212,.08);
            }

                .send-btn:hover::before {
                    transform: translateX(100%);
                }

            .send-btn:active {
                transform: translateY(0);
            }


        /* ==========================
                   Help
                ========================== */

        .login-help {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid rgba(255,255,255,.07);
            text-align: center;
            color: rgba(255,255,255,.40);
            font-size: 12px;
        }


        /* ==========================
                   Back Button
                ========================== */

        .back-home {
            display: block;
            margin-top: 20px;
            text-align: center;
            color: rgba(255,255,255,.45);
            text-decoration: none;
            font-size: 12px;
            transition: color .25s ease;
        }

            .back-home:hover {
                color: #00f0ff;
            }


        /* ==========================
                   Mobile
                ========================== */

        @@media (max-width: 480px) {

            body {
                padding: 20px 15px;
            }

            .login-card {
                padding: 32px 22px 25px;
                border-radius: 19px;
            }

                .login-card h3 {
                    font-size: 21px;
                }

            .login-logo {
                width: 56px;
                height: 56px;
            }

            .phone-input,
            .send-btn {
                height: 50px;
            }
        }

    </style>
</head>

<body>

    <div class="login-orb login-orb-1"></div>
    <div class="login-orb login-orb-2"></div>

    <div class="login-wrapper">

        <!-- Brand -->
        <div class="login-brand">

            <div class="login-logo">

                <svg viewBox="0 0 100 100"
                     xmlns="http://www.w3.org/2000/svg">

                    <defs>
                        <linearGradient id="loginLogoGrad"
                                        x1="0%"
                                        y1="0%"
                                        x2="100%"
                                        y2="100%">

                            <stop offset="0%"
                                  style="stop-color:#00f0ff" />

                            <stop offset="100%"
                                  style="stop-color:#ff00d4" />

                        </linearGradient>
                    </defs>

                    <polygon points="50,10 85,32 85,68 50,90 15,68 15,32"
                             fill="none"
                             stroke="url(#loginLogoGrad)"
                             stroke-width="3" />

                    <circle cx="50"
                            cy="50"
                            r="10"
                            fill="url(#loginLogoGrad)" />

                </svg>

            </div>

            <h2>ARAYAN</h2>

            <p>Programming & Web Development</p>

        </div>


        <!-- Login Card -->
        <div class="login-card">

            <h3>ورود / ثبت نام </h3>

            <p class="login-description">
                برای ورود یا ثت نام در سایت ، لطفا شماره موبایل خود را وارد کنید.
            </p>


            <form asp-action="SendOtp"
                  asp-route-returnUrl="@ViewBag.ReturnUrl"
                  method="post">

                <div class="input-group-custom">

                    <label class="input-label"
                           for="phone">
                        شماره موبایل
                    </label>

                    <input id="phone"
                           class="phone-input"
                           type="text"
                           name="phoneNumber"
                           placeholder="09123456789"
                           maxlength="11"
                           inputmode="numeric"
                           autocomplete="tel"
                           required />

                </div>


                <button class="send-btn"
                        type="submit">

                    ارسال کد تأیید

                </button>

            </form>


            <div class="login-help">
                کد تأیید ورود از طریق پیامک برای شما ارسال خواهد شد.
            </div>

        </div>


        <a href="/" class="back-home">
            ← بازگشت به صفحه اصلی
        </a>

    </div>


    <script src="/assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>


    <script>

        const phoneInput = document.getElementById("phone");

        phoneInput.addEventListener("input", function () {

            let v = this.value.replace(/[^0-9]/g, "");

            if (v.length > 0 && v[0] !== "0") {
                v = "0";
            }

            if (v.length > 11) {
                v = v.slice(0, 11);
            }

            this.value = v;

        });


        document.querySelector("form").addEventListener("submit", function (e) {

            if (phoneInput.value.length !== 11) {

                alert("شماره موبایل باید 11 رقم باشد");

                e.preventDefault();

            }

        });

    </script>

</body>
</html>