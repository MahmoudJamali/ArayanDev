
@using Business.Handlers.EnrollCourses.Queries

@model List<EnrollmentListItemDto>

@{
    ViewData["Title"] = "داشبورد مدیریت";
}

@section Styles {

    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />

    <style>

        /* =========================================================
                   Dashboard Header
                ========================================================= */

        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .dashboard-title {
            margin: 0;
            color: #ffffff;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .dashboard-subtitle {
            margin: 7px 0 0;
            color: #8f96a3;
            font-size: 14px;
        }


        /* =========================================================
                   Stats
                ========================================================= */

        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 28px;
        }

        .stat-card {
            position: relative;
            overflow: hidden;
            min-height: 125px;
            padding: 22px;
            border-radius: 18px;
            background: linear-gradient( 145deg, rgba(255,255,255,.055), rgba(255,255,255,.015) );
            border: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
            transition: .3s ease;
        }

            .stat-card:hover {
                transform: translateY(-4px);
                border-color: rgba(120,90,255,.4);
                box-shadow: 0 18px 45px rgba(0,0,0,.25), 0 0 30px rgba(120,90,255,.08);
            }

            .stat-card::before {
                content: "";
                position: absolute;
                width: 100px;
                height: 100px;
                border-radius: 50%;
                right: -35px;
                top: -40px;
                background: rgba(124,92,255,.08);
                filter: blur(4px);
            }

        .stat-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            margin-bottom: 14px;
            background: rgba(124,92,255,.12);
            color: #9b82ff;
            font-size: 18px;
        }

        .stat-label {
            color: #8f96a3;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .stat-value {
            color: #ffffff;
            font-size: 24px;
            font-weight: 700;
        }


        /* =========================================================
                   Main Table Card
                ========================================================= */

        .dashboard-card {
            background: linear-gradient( 145deg, rgba(255,255,255,.045), rgba(255,255,255,.018) );
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 55px rgba(0,0,0,.22);
        }

        .dashboard-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 22px 24px;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .dashboard-card-title {
            margin: 0;
            color: #ffffff;
            font-size: 17px;
            font-weight: 700;
        }

        .dashboard-card-description {
            margin: 5px 0 0;
            color: #777f8d;
            font-size: 12px;
        }

        .dashboard-card-body {
            padding: 24px;
        }


        /* =========================================================
                   DataTables
                ========================================================= */

        #enrollmentsTable {
            width: 100% !important;
            border-collapse: separate !important;
            border-spacing: 0;
            color: #dce1e8;
            margin: 0 !important;
        }

            #enrollmentsTable thead th {
                background: rgba(255,255,255,.035);
                color: #9fa7b5;
                border: none !important;
                border-bottom: 1px solid rgba(255,255,255,.08) !important;
                padding: 15px 14px;
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
            }

            #enrollmentsTable tbody td {
                background: transparent !important;
                color: #dce1e8;
                border: none !important;
                border-bottom: 1px solid rgba(255,255,255,.055) !important;
                padding: 15px 14px;
                font-size: 13px;
                vertical-align: middle;
            }

            #enrollmentsTable tbody tr {
                transition: .2s ease;
            }

                #enrollmentsTable tbody tr:hover td {
                    background: rgba(124,92,255,.055) !important;
                }

                #enrollmentsTable tbody tr:last-child td {
                    border-bottom: none !important;
                }


        /* =========================================================
                   Action Button
                ========================================================= */

        .delete-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 70px;
            padding: 7px 12px;
            border-radius: 8px;
            border: 1px solid rgba(255,75,75,.25);
            background: rgba(255,75,75,.08);
            color: #ff7777;
            font-size: 12px;
            text-decoration: none;
            transition: .25s ease;
        }

            .delete-btn:hover {
                background: rgba(255,75,75,.16);
                border-color: rgba(255,75,75,.45);
                color: #ff9696;
                transform: translateY(-1px);
            }


        /* =========================================================
                   DataTables Controls
                ========================================================= */

        .dataTables_wrapper {
            color: #8f96a3;
        }

            .dataTables_wrapper .dataTables_filter {
                float: left;
                text-align: left;
                margin-bottom: 18px;
            }

            .dataTables_wrapper .dataTables_length {
                float: right;
                margin-bottom: 18px;
            }

                .dataTables_wrapper .dataTables_filter label,
                .dataTables_wrapper .dataTables_length label {
                    color: #8f96a3;
                    font-size: 13px;
                }

            .dataTables_wrapper .dataTables_filter input {
                width: 210px;
                margin-right: 8px;
                padding: 8px 12px;
                border-radius: 9px;
                border: 1px solid rgba(255,255,255,.1);
                background: rgba(255,255,255,.035);
                color: #fff;
                outline: none;
            }

                .dataTables_wrapper .dataTables_filter input:focus {
                    border-color: rgba(124,92,255,.6);
                    box-shadow: 0 0 0 3px rgba(124,92,255,.1);
                }

            .dataTables_wrapper .dataTables_length select {
                margin: 0 6px;
                padding: 7px 30px 7px 10px;
                border-radius: 8px;
                border: 1px solid rgba(255,255,255,.1);
                background-color: #151923;
                color: #ddd;
                outline: none;
            }


        /* =========================================================
                   Buttons
                ========================================================= */

        .dt-buttons {
            float: right;
            margin-bottom: 18px;
        }

            .dt-buttons .btn {
                border-radius: 8px !important;
                margin-left: 7px !important;
                border: 1px solid rgba(255,255,255,.1) !important;
                font-size: 12px;
                padding: 8px 14px;
                transition: .25s ease;
            }

            .dt-buttons .buttons-excel {
                background: rgba(45,190,120,.1) !important;
                border-color: rgba(45,190,120,.25) !important;
                color: #5ee5a2 !important;
            }

                .dt-buttons .buttons-excel:hover {
                    background: rgba(45,190,120,.18) !important;
                }

            .dt-buttons .buttons-copy {
                background: rgba(255,255,255,.05) !important;
                color: #c7ccd5 !important;
            }

                .dt-buttons .buttons-copy:hover {
                    background: rgba(255,255,255,.1) !important;
                }


        /* =========================================================
                   Info
                ========================================================= */

        .dataTables_wrapper .dataTables_info {
            float: right;
            color: #707887;
            font-size: 12px;
            padding-top: 15px;
        }


        /* =========================================================
                   Pagination
                ========================================================= */

        div.dataTables_wrapper div.dataTables_paginate {
            float: left;
            text-align: left;
            padding-top: 10px;
        }

        .dataTables_wrapper .pagination {
            gap: 4px;
        }

        .dataTables_wrapper .page-item .page-link {
            min-width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px !important;
            border: 1px solid rgba(255,255,255,.08) !important;
            background: rgba(255,255,255,.03);
            color: #9da5b3;
            font-size: 12px;
            transition: .2s ease;
        }

            .dataTables_wrapper .page-item .page-link:hover {
                background: rgba(124,92,255,.1);
                color: #b6a5ff;
            }

        .dataTables_wrapper .page-item.active .page-link {
            background: #7c5cff !important;
            border-color: #7c5cff !important;
            color: #fff !important;
        }

        .dataTables_wrapper .page-item.disabled .page-link {
            background: rgba(255,255,255,.02);
            color: #454b56;
        }


        /* =========================================================
                   Empty / Responsive
                ========================================================= */

        .table-responsive {
            border-radius: 12px;
        }

        @@media (max-width: 991px) {
            .dashboard-stats

        {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-header {
            align-items: flex-start;
        }

        }

        @@media (max-width: 575px) {
            .dashboard-title

        {
            font-size: 21px;
        }

        .dashboard-subtitle {
            font-size: 12px;
        }

        .dashboard-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .dashboard-card-header {
            padding: 18px;
        }

        .dashboard-card-body {
            padding: 14px;
        }

        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length,
        .dt-buttons {
            float: none;
            text-align: right;
            width: 100%;
        }

            .dataTables_wrapper .dataTables_filter input {
                width: 100%;
                margin: 8px 0 0;
            }

        div.dataTables_wrapper div.dataTables_paginate,
        .dataTables_wrapper .dataTables_info {
            float: none;
            text-align: center;
        }

        }
    </style>
}


<!-- =========================================================
     Dashboard Header
========================================================= -->

<div class="dashboard-header">

    <div>
        <h1 class="dashboard-title">
            داشبورد مدیریت
        </h1>

        <p class="dashboard-subtitle">
            مدیریت کاربران، دوره‌ها و ثبت‌نام‌های آکادمی آرایان
        </p>
    </div>

</div>


<!-- =========================================================
     Statistics
========================================================= -->

<div class="dashboard-stats">

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-user-graduate"></i>
        </div>

        <div class="stat-label">
            کل ثبت‌نام‌ها
        </div>

        <div class="stat-value">
            @Model.Count
        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-book-open"></i>
        </div>

        <div class="stat-label">
            ثبت‌نام‌های فعال
        </div>

        <div class="stat-value">
            @Model.Count
        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-chart-line"></i>
        </div>

        <div class="stat-label">
            وضعیت سیستم
        </div>

        <div class="stat-value"
             style="font-size:18px;color:#5ee5a2;">

            آنلاین
        </div>

    </div>

</div>


<!-- =========================================================
     Enrollment Table
========================================================= -->

<div class="dashboard-card">

    <div class="dashboard-card-header">

        <div>

            <h2 class="dashboard-card-title">
                ثبت‌نام‌های دوره‌ها
            </h2>

            <p class="dashboard-card-description">
                مشاهده و مدیریت آخرین ثبت‌نام‌های انجام‌شده
            </p>

        </div>

    </div>


    <div class="dashboard-card-body">

        <div class="table-responsive">

            <table id="enrollmentsTable"
                   class="table"
                   style="width:100%">

                <thead>

                    <tr>
                        <th>نام</th>
                        <th>نام خانوادگی</th>
                        <th>شهر</th>
                        <th>شماره موبایل</th>
                        <th>عنوان دوره</th>
                        <th>تاریخ ثبت‌نام</th>
                        <th>عملیات</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Name
                            </td>

                            <td>
                                @item.Family
                            </td>

                            <td>
                                @item.City
                            </td>

                            <td>
                                @item.PhoneNumber
                            </td>

                            <td>
                                @item.CourseTitle
                            </td>

                            <td>
                                @item.EnrollDate.ToString("yyyy/MM/dd")
                            </td>

                            <td>

                                <a href="#"
                                   class="delete-btn">

                                    <i class="fas fa-trash-alt"></i>

                                    حذف

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <!-- DataTables -->

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Buttons -->

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>


    <script>

        $(document).ready(function () {

            $('#enrollmentsTable').DataTable({

                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fa.json'
                },

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                order: [
                    [5, 'desc']
                ],

                dom:
                    '<"row align-items-center mb-2"' +
                        '<"col-md-6"B>' +
                        '<"col-md-6"f>' +
                    '>' +
                    'rt' +
                    '<"row align-items-center mt-2"' +
                        '<"col-md-6"i>' +
                        '<"col-md-6"p>' +
                    '>',

                buttons: [

                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel me-1"></i> خروجی اکسل',
                        className: 'buttons-excel'
                    },

                    {
                        extend: 'copyHtml5',
                        text: '<i class="fas fa-copy me-1"></i> کپی',
                        className: 'buttons-copy'
                    }

                ],

                responsive: true,

                autoWidth: false

            });

        });

    </script>
}

