					if (!response.ok) {
						throw new Error("خطا در دریافت دوره‌ها");
					}

					return response.text();
				})
				.then(html => {

					coursesContainer.innerHTML = html;

				})
				.catch(error => {

					console.error(error);

					coursesContainer.innerHTML = `
						<div class="students-empty">
							دریافت دوره‌ها با خطا مواجه شد.
						</div>
					`;

				});

		});

	</script>

