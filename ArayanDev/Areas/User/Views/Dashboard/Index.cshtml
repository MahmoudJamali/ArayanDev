@using Business.Handlers.Users.Queries
@model UserDashboardViewModel
@using System.Globalization
@using Entities.Enums

@{
    ViewData["Title"] = "داشبورد کاربری";

    string birthDateShamsi = "-";

    if (Model.BirthDay != default)
    {
        var pc = new PersianCalendar();
        var date = Model.BirthDay.ToDateTime(TimeOnly.MinValue);

        birthDateShamsi =
            $"{pc.GetYear(date)}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00}";
    }

    var fullName = $"{Model.Name} {Model.Family}".Trim();

    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = "کاربر گرامی";
    }
}

<style>

    .user-dashboard {
        direction: rtl;
        color: #e8eaf0;
    }

    /* Header */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dashboard-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #ffffff;
    }

    .dashboard-subtitle {
        margin: 7px 0 0;
        color: #9298aa;
        font-size: 14px;
    }

    .back-site-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 17px;
        border-radius: 12px;
        color: #dfe3ef;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.09);
        text-decoration: none;
        transition: .25s ease;
    }

        .back-site-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.09);
            transform: translateY(-2px);
        }

    /* Profile Hero */

    .profile-hero {
        position: relative;
        overflow: hidden;
        padding: 28px;
        margin-bottom: 24px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.08);
        background: radial-gradient(circle at 90% 20%, rgba(124,58,237,.22), transparent 30%), radial-gradient(circle at 10% 80%, rgba(37,117,252,.12), transparent 30%), rgba(16,18,27,.92);
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

        .profile-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            left: -70px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(124,58,237,.12);
            filter: blur(25px);
        }

    .profile-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .profile-info {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        flex: 0 0 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #fff;
        background: linear-gradient(135deg,#6a11cb,#2575fc);
        box-shadow: 0 10px 30px rgba(37,117,252,.25);
    }

    .profile-name {
        margin: 0 0 7px;
        font-size: 21px;
        font-weight: 700;
        color: #fff;
    }

    .profile-phone {
        margin: 0;
        color: #9da3b5;
        font-size: 14px;
        direction: ltr;
        text-align: right;
    }

    .edit-profile-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 12px;
        border: 1px solid rgba(124,58,237,.35);
        background: rgba(124,58,237,.12);
        color: #c9b5ff;
        text-decoration: none;
        transition: .25s ease;
    }

        .edit-profile-btn:hover {
            background: rgba(124,58,237,.22);
            color: #fff;
            transform: translateY(-2px);
        }

    /* Warning */

    .profile-warning {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 24px;
        padding: 16px 18px;
        border-radius: 14px;
        color: #f8d98b;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.18);
    }

    .profile-warning-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .complete-profile-btn {
        white-space: nowrap;
        padding: 8px 14px;
        border-radius: 9px;
        color: #fff;
        background: #d97706;
        text-decoration: none;
        font-size: 13px;
    }

    /* Cards */

    .dashboard-card {
        height: 100%;
        overflow: hidden;
        border-radius: 18px;
        background: rgba(16,18,27,.92);
        border: 1px solid rgba(255,255,255,.07);
        box-shadow: 0 15px 40px rgba(0,0,0,.18);
    }

    .dashboard-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .dashboard-card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 17px;
        font-weight: 600;
        color: #fff;
    }

        .dashboard-card-title i {
            color: #8b5cf6;
        }

    .dashboard-card-body {
        padding: 22px;
    }

    /* Information Grid */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .info-item {
        padding: 16px;
        border-radius: 13px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.05);
        transition: .25s ease;
    }

        .info-item:hover {
            background: rgba(255,255,255,.055);
            transform: translateY(-2px);
        }

    .info-label {
        display: block;
        margin-bottom: 7px;
        color: #7f879c;
        font-size: 12px;
    }

    .info-value {
        display: block;
        color: #edf0f7;
        font-size: 14px;
        font-weight: 500;
        word-break: break-word;
    }

    /* Courses */

    .courses-table-wrapper {
        overflow-x: auto;
    }

    .courses-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0 8px;
    }

        .courses-table thead th {
            padding: 10px 14px;
            border: 0;
            color: #7f879c;
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
        }

        .courses-table tbody tr {
            background: rgba(255,255,255,.035);
            transition: .2s ease;
        }

            .courses-table tbody tr:hover {
                background: rgba(255,255,255,.06);
            }

        .courses-table tbody td {
            padding: 15px 14px;
            border: 0;
            color: #dfe3ec;
            font-size: 13px;
            vertical-align: middle;
            white-space: nowrap;
        }

            .courses-table tbody td:first-child {
                border-radius: 0 10px 10px 0;
                color: #fff;
                font-weight: 600;
            }

            .courses-table tbody td:last-child {
                border-radius: 10px 0 0 10px;
            }

    .course-type {
        display: inline-flex;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        background: rgba(37,117,252,.12);
        color: #79aaff;
    }

    .course-price {
        color: #a78bfa !important;
        font-weight: 600 !important;
    }

    .free-course {
        color: #34d399 !important;
    }

    /* Empty */

    .empty-courses {
        text-align: center;
        padding: 45px 20px;
        color: #858da0;
    }

        .empty-courses i {
            display: block;
            margin-bottom: 14px;
            font-size: 38px;
            color: #6d7385;
        }

    /* Responsive */

    @@media (max-width: 991px) {

        .info-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767px) {

        .dashboard-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-content {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-info {
            width: 100%;
        }

        .edit-profile-btn {
            width: 100%;
            justify-content: center;
        }

        .profile-warning {
            align-items: flex-start;
            flex-direction: column;
        }

        .complete-profile-btn {
            width: 100%;
            text-align: center;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {

        .profile-hero {
            padding: 20px;
        }

        .profile-avatar {
            width: 60px;
            height: 60px;
            flex-basis: 60px;
            font-size: 25px;
        }

        .profile-name {
            font-size: 18px;
        }

        .dashboard-title {
            font-size: 23px;
        }

        .dashboard-card-header,
        .dashboard-card-body {
            padding: 16px;
        }
    }

</style>


<div class="user-dashboard">

    <!-- Header -->

@*     <div class="dashboard-header">

        <div>
            <h1 class="dashboard-title">
                داشبورد کاربری
            </h1>

            <p class="dashboard-subtitle">
                مدیریت اطلاعات حساب و دوره‌های آموزشی شما
            </p>
        </div>

        <a href="/"
           class="back-site-btn">
            <i class="far fa-home"></i>
            بازگشت به سایت
        </a>

    </div> *@


    <!-- Profile Hero -->

    <div class="profile-hero">

        <div class="profile-content">

            <div class="profile-info">

                <div class="profile-avatar">
                    <i class="far fa-user"></i>
                </div>

                <div>

                    <h2 class="profile-name">
                        @fullName
                    </h2>

                    <p class="profile-phone">
                        @Model.PhoneNumber
                    </p>

                </div>

            </div>

            <a asp-area="User"
               asp-controller="Dashboard"
               asp-action="EditProfile"
               class="edit-profile-btn">

                <i class="far fa-pen"></i>

                ویرایش اطلاعات

            </a>

        </div>

    </div>


    <!-- Profile Warning -->
    @if (string.IsNullOrWhiteSpace(Model.Name))
    {
        <div class="profile-warning">

            <div class="profile-warning-content">

                <i class="far fa-circle-exclamation"></i>

                <span>
                    لطفاً اطلاعات پروفایل خود را تکمیل کنید.
                </span>

            </div>

            <a asp-area="User"
               asp-controller="Dashboard"
               asp-action="EditProfile"
               class="complete-profile-btn">

                تکمیل اطلاعات

            </a>

        </div>
    }


    <!-- Personal Information -->

    <div class="dashboard-card mb-4">

        <div class="dashboard-card-header">

            <h2 class="dashboard-card-title">

                <i class="far fa-id-card"></i>

                اطلاعات کاربری

            </h2>

        </div>

        <div class="dashboard-card-body">

            <div class="info-grid">

                <div class="info-item">
                    <span class="info-label">نام</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.Name) ? "-" : Model.Name)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">نام خانوادگی</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.Family) ? "-" : Model.Family)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">شماره موبایل</span>
                    <span class="info-value" dir="ltr">
                        @Model.PhoneNumber
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">کد ملی</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.NationalCode) ? "-" : Model.NationalCode)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">شهر</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">تاریخ تولد</span>
                    <span class="info-value">
                        @birthDateShamsi
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">مدرک تحصیلی</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.EducationDegree)
                            ? "-"
                            : Model.EducationDegree)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">رشته تحصیلی</span>
                    <span class="info-value">
                        @(string.IsNullOrWhiteSpace(Model.Major)
                            ? "-"
                            : Model.Major)
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">ایمیل</span>
                    <span class="info-value" dir="ltr">
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "-"
                            : Model.Email)
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- Registered Courses -->

    <div class="dashboard-card">

        <div class="dashboard-card-header">

            <h2 class="dashboard-card-title">

                <i class="far fa-graduation-cap"></i>

                دوره‌های ثبت‌نام شده

            </h2>

            <span style="color:#7f879c;font-size:12px;">
                @Model.Courses.Count دوره
            </span>

        </div>

        <div class="dashboard-card-body">

            @if (!Model.Courses.Any())
            {
                <div class="empty-courses">

                    <i class="far fa-book-open"></i>

                    <div>
                        شما هنوز در هیچ دوره‌ای ثبت‌نام نکرده‌اید.
                    </div>

                </div>
            }
            else
            {
                <div class="courses-table-wrapper">

                    <table class="courses-table">

                        <thead>

                            <tr>

                                <th>عنوان دوره</th>

                                <th>نوع دوره</th>

                                <th>قیمت</th>

                                <th>تاریخ شروع</th>

                                <th>تاریخ ثبت‌نام</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                var pc = new PersianCalendar();
                            }

                            @foreach (var item in Model.Courses)
                            {
                                string startDateShamsi = "-";
                                string enrollDateShamsi = "-";

                                if (item.StartDate.HasValue)
                                {
                                    var sd = item.StartDate.Value;

                                    startDateShamsi =
                                    $"{pc.GetYear(sd)}/{pc.GetMonth(sd):00}/{pc.GetDayOfMonth(sd):00}";
                                }

                                var ed = item.EnrollDate;

                                enrollDateShamsi =
                                $"{pc.GetYear(ed)}/{pc.GetMonth(ed):00}/{pc.GetDayOfMonth(ed):00}";

                                <tr>

                                    <td>
                                        @item.Title
                                    </td>

                                    <td>

                                        <span class="course-type">

                                            @(item.CourseType == CourseType.InPerson
                                                ? "حضوری"
                                                : "آنلاین")

                                        </span>

                                    </td>

                                    <td class="@(item.IsFree ? "free-course" : "course-price")">

                                        @(item.IsFree
                                            ? "رایگان"
                                            : $"{item.Price:N0} تومان")

                                    </td>

                                    <td>
                                        @startDateShamsi
                                    </td>

                                    <td>
                                        @enrollDateShamsi
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>