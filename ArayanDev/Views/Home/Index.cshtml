@section Scripts {

	<script>

		document.addEventListener("DOMContentLoaded", function () {

			const studentsContainer =
				document.getElementById("students-section");

			if (!studentsContainer) {
				return;
			}


			/*
			 * =========================================
			 * دریافت دانشجویان
			 * =========================================
			 */

			fetch("/Home/Students")
				.then(response => {

					if (!response.ok) {
						throw new Error("خطا در دریافت دانشجویان");
					}

					return response.text();
				})
				.then(html => {

					studentsContainer.innerHTML = html;

					/*
					 * بسیار مهم:
					 * بعد از لود Partial،
					 * carousel را راه‌اندازی می‌کنیم.
					 */

					initStudentsCarousel();

				})
				.catch(error => {

					console.error(error);

					studentsContainer.innerHTML = `
						<div class="students-empty">
							دریافت اطلاعات دانشجویان با خطا مواجه شد.
						</div>
					`;

				});

		});


		/*
		 * =========================================
		 * Students Carousel
		 * =========================================
		 */

		function initStudentsCarousel() {

			const slides =
				Array.from(
					document.querySelectorAll(
						"#studentsGrid .student-slide"
					)
				);


			/*
			 * اگر دانشجویی نداریم
			 */

			if (slides.length === 0) {
				return;
			}


			/*
			 * همیشه فقط 4 کارت
			 */

			const visibleCount = 4;


			/*
			 * اگر 4 نفر یا کمتر داریم،
			 * همه را نمایش بده و تمام.
			 */

			if (slides.length <= visibleCount) {

				slides.forEach(function (slide) {

					slide.classList.add("active");

				});

				return;
			}


			/*
			 * موقعیت فعلی
			 */

			let startIndex = 0;


			/*
			 * نمایش 4 نفر
			 */

			function showStudents() {

				/*
				 * ابتدا همه مخفی
				 */

				slides.forEach(function (slide) {

					slide.classList.remove("active");

				});


				/*
				 * سپس 4 نفر نمایش داده شوند
				 */

				for (
					let i = 0;
					i < visibleCount;
					i++
				) {

					const index =
						(startIndex + i) % slides.length;


					slides[index]
						.classList
						.add("active");

				}

			}


			/*
			 * نمایش اولیه
			 */

			showStudents();


			/*
			 * چرخش خودکار
			 * هر 3 ثانیه
			 */

			setInterval(function () {

				startIndex++;


				/*
				 * رسیدن به انتهای لیست
				 */

				if (
					startIndex >= slides.length
				) {

					startIndex = 0;

				}


				showStudents();

			}, 3000);

		}

	</script>


	<script>

		document.addEventListener("DOMContentLoaded", function () {

			const coursesContainer =
				document.getElementById("courses-section");

			if (!coursesContainer)
				return;

			fetch("/Course/Courses")
