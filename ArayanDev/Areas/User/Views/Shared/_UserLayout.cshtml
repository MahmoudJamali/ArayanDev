
@{
    var fullName = User.FindFirst("FullName")?.Value;
    var phone = User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value;

    var displayName = !string.IsNullOrWhiteSpace(fullName)
        ? fullName
        : phone ?? "کاربر";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(ViewData["Title"] ?? "پنل کاربری") | آکادمی آرایان
    </title>

    <link href="/assets/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="/assets/css/fontawesome.min.css"
          rel="stylesheet" />

    <style>

        /* =========================================================
                   Base
                ========================================================= */

        :root {
            --user-bg: #080a10;
            --user-sidebar: #0d1018;
            --user-card: rgba(255,255,255,.045);
            --user-border: rgba(255,255,255,.08);
            --user-text: #f4f6fa;
            --user-muted: #858d9d;
            --user-primary: #7c5cff;
            --user-primary-light: #9b82ff;
            --user-danger: #ff6b7a;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            background: radial-gradient( circle at 10% 10%, rgba(124,92,255,.08), transparent 28% ), radial-gradient( circle at 90% 80%, rgba(50,140,255,.05), transparent 30% ), var(--user-bg);
            color: var(--user-text);
            font-family: Tahoma, Arial, sans-serif;
            overflow-x: hidden;
        }


        /* =========================================================
                   Ambient Background
                ========================================================= */

        .user-ambient {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .user-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: .16;
        }

        .user-orb-1 {
            width: 320px;
            height: 320px;
            background: #6d4aff;
            top: -140px;
            right: 10%;
        }

        .user-orb-2 {
            width: 260px;
            height: 260px;
            background: #2677ff;
            bottom: -100px;
            left: 10%;
        }


        /* =========================================================
                   Layout
                ========================================================= */

        .user-panel {
            min-height: 100vh;
        }


        /* =========================================================
                   Sidebar
                ========================================================= */

        .user-sidebar {
            width: 270px;
            height: 100vh;
            position: fixed;
            right: 0;
            top: 0;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            background: linear-gradient( 180deg, rgba(18,21,31,.98), rgba(9,11,17,.98) );
            border-left: 1px solid var(--user-border);
            box-shadow: -20px 0 60px rgba(0,0,0,.25);
            transition: transform .3s ease;
        }


        /* =========================================================
                   Brand
                ========================================================= */

        .user-brand {
            padding: 25px 22px 22px;
            border-bottom: 1px solid var(--user-border);
        }

        .user-brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #fff;
            text-decoration: none;
        }

        .user-brand-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: linear-gradient( 135deg, #7c5cff, #4b36c9 );
            color: #fff;
            box-shadow: 0 8px 25px rgba(124,92,255,.28);
        }

        .user-brand-text strong {
            display: block;
            font-size: 15px;
            font-weight: 700;
        }

        .user-brand-text span {
            display: block;
            margin-top: 3px;
            color: #737b8c;
            font-size: 10px;
        }


        /* =========================================================
                   User Profile
                ========================================================= */

        .user-profile {
            margin: 20px 16px;
            padding: 15px;
            border-radius: 15px;
            background: rgba(255,255,255,.035);
            border: 1px solid rgba(255,255,255,.06);
        }

        .user-profile-inner {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: linear-gradient( 135deg, #7c5cff, #4776ff );
            color: #fff;
            font-size: 16px;
            box-shadow: 0 6px 20px rgba(124,92,255,.2);
        }

        .user-profile-name {
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .user-profile-status {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 5px;
            color: #70798a;
            font-size: 10px;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #45d39c;
            box-shadow: 0 0 8px rgba(69,211,156,.7);
        }


        /* =========================================================
                   Navigation
                ========================================================= */

        .user-navigation {
            flex: 1;
            padding: 0 12px;
            overflow-y: auto;
        }

        .navigation-title {
            padding: 8px 14px;
            color: #555e6e;
            font-size: 10px;
            font-weight: 600;
        }

        .user-nav-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 4px 0;
            padding: 12px 14px;
            border-radius: 11px;
            color: #8d95a4;
            text-decoration: none;
            font-size: 13px;
            transition: .25s ease;
        }

            .user-nav-link i {
                width: 20px;
                text-align: center;
                font-size: 14px;
            }

            .user-nav-link:hover {
                background: rgba(124,92,255,.08);
                color: #fff;
            }

            .user-nav-link.active {
                background: linear-gradient( 90deg, rgba(124,92,255,.18), rgba(124,92,255,.05) );
                color: #fff;
                border: 1px solid rgba(124,92,255,.15);
            }

                .user-nav-link.active i {
                    color: var(--user-primary-light);
                }

                .user-nav-link.active::before {
                    content: "";
                    position: absolute;
                    right: -12px;
                    width: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: linear-gradient( 180deg, #9b82ff, #6245e9 );
                }


        /* =========================================================
                   Sidebar Footer
                ========================================================= */

        .user-sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--user-border);
        }

        .logout-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 11px;
            border-radius: 10px;
            background: rgba(255,107,122,.05);
            border: 1px solid rgba(255,107,122,.1);
            color: var(--user-danger);
            text-decoration: none;
            font-size: 12px;
            transition: .25s ease;
        }

            .logout-link:hover {
                background: rgba(255,107,122,.1);
                color: #ff8b98;
            }


        /* =========================================================
                   Main Content
                ========================================================= */

        .user-main {
            margin-right: 270px;
            min-height: 100vh;
            padding: 30px;
        }

        .user-main-inner {
            max-width: 1500px;
            margin: 0 auto;
        }


        /* =========================================================
                   Top Bar
                ========================================================= */

        .user-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .user-page-title {
            margin: 0;
            color: #fff;
            font-size: 24px;
            font-weight: 700;
        }

        .user-page-subtitle {
            margin: 6px 0 0;
            color: var(--user-muted);
            font-size: 12px;
        }

        .site-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 14px;
            border-radius: 9px;
            background: rgba(255,255,255,.035);
            border: 1px solid var(--user-border);
            color: #aeb5c2;
            text-decoration: none;
            font-size: 12px;
            transition: .25s ease;
        }

            .site-link:hover {
                color: #fff;
                border-color: rgba(124,92,255,.35);
                background: rgba(124,92,255,.08);
            }


        /* =========================================================
                   Mobile Header
                ========================================================= */

        .mobile-user-header {
            display: none;
            height: 64px;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(9,11,17,.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--user-border);
        }

        .mobile-menu-button {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--user-border);
            border-radius: 10px;
            background: rgba(255,255,255,.04);
            color: #fff;
            cursor: pointer;
        }

        .mobile-title {
            color: #fff;
            font-size: 14px;
            font-weight: 600;
        }


        /* =========================================================
                   Overlay
                ========================================================= */

        .user-sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1040;
            background: rgba(0,0,0,.65);
            backdrop-filter: blur(3px);
        }


        /* =========================================================
                   Scrollbar
                ========================================================= */

        .user-sidebar::-webkit-scrollbar,
        .user-navigation::-webkit-scrollbar {
            width: 4px;
        }

        .user-sidebar::-webkit-scrollbar-thumb,
        .user-navigation::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.1);
            border-radius: 10px;
        }


        /* =========================================================
                   Responsive
                ========================================================= */

        @@media (max-width: 991.98px) {
            .user-sidebar

        {
            transform: translateX(100%);
        }

        .user-sidebar.show {
            transform: translateX(0);
        }

        .user-sidebar-overlay.show {
            display: block;
        }

        .mobile-user-header {
            display: flex;
        }

        .user-main {
            margin-right: 0;
            padding: 22px 18px;
        }

        }


        @@media (max-width: 575.98px) {
            .user-main

        {
            padding: 18px 12px;
        }

        .user-page-title {
            font-size: 20px;
        }

        .user-page-subtitle {
            font-size: 11px;
        }

        .site-link span {
            display: none;
        }

        .user-sidebar {
            width: 285px;
        }

        }
    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- Ambient Background -->

    <div class="user-ambient">

        <div class="user-orb user-orb-1"></div>

        <div class="user-orb user-orb-2"></div>

    </div>


    <div class="user-panel">


        <!-- =====================================================
             Mobile Header
        ====================================================== -->

        <header class="mobile-user-header">

            <button type="button"
                    class="mobile-menu-button"
                    id="userMenuToggle"
                    aria-label="باز کردن منو">

                <i class="fas fa-bars"></i>

            </button>

            <div class="mobile-title">
                پنل کاربری آرایان
            </div>

            <a href="/"
               class="text-decoration-none"
               style="color:#9b82ff;">

                <i class="fas fa-home"></i>

            </a>

        </header>


        <!-- Sidebar Overlay -->

        <div class="user-sidebar-overlay"
             id="userSidebarOverlay">
        </div>


        <!-- =====================================================
             Sidebar
        ====================================================== -->

        <aside class="user-sidebar"
               id="userSidebar">


            <!-- Brand -->

            <div class="user-brand">

                <a href="/"
                   class="user-brand-logo">

                    <div class="user-brand-icon">

                        <i class="fas fa-code"></i>

                    </div>

                    <div class="user-brand-text">

                        <strong>
                            آکادمی آرایان
                        </strong>

                        <span>
                            Programming & Web Development
                        </span>

                    </div>

                </a>

            </div>


            <!-- User Profile -->

            <div class="user-profile">

                <div class="user-profile-inner">

                    <div class="user-avatar">

                        <i class="fas fa-user"></i>

                    </div>

                    <div>

                        <div class="user-profile-name">
                            @displayName
                        </div>

                        <div class="user-profile-status">

                            <span class="status-dot"></span>

                            حساب کاربری فعال

                        </div>

                    </div>

                </div>

            </div>


            <!-- Navigation -->

            <nav class="user-navigation">

                <div class="navigation-title">
                    حساب کاربری
                </div>


                <a asp-area="User"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="user-nav-link">

                    <i class="fas fa-grid-2"></i>

                    <span>
                        داشبورد
                    </span>

                </a>


                <a href="#"
                   class="user-nav-link">

                    <i class="fas fa-book-open"></i>

                    <span>
                        دوره‌های من
                    </span>

                </a>


                <a href="#"
                   class="user-nav-link">

                    <i class="fas fa-certificate"></i>

                    <span>
                        گواهینامه‌ها
                    </span>

                </a>


                <a href="#"
                   class="user-nav-link">

                    <i class="fas fa-file-lines"></i>

                    <span>
                        پروژه‌های من
                    </span>

                </a>


                <div class="navigation-title mt-3">
                    حساب و تنظیمات
                </div>


                <a href="#"
                   class="user-nav-link">

                    <i class="fas fa-user-gear"></i>

                    <span>
                        ویرایش پروفایل
                    </span>

                </a>


                <a href="/"
                   class="user-nav-link">

                    <i class="fas fa-house"></i>

                    <span>
                        مشاهده سایت
                    </span>

                </a>

            </nav>


            <!-- Sidebar Footer -->

            <div class="user-sidebar-footer">

                <a href="/Auth/Logout"
                   class="logout-link">

                    <i class="fas fa-right-from-bracket"></i>

                    خروج از حساب

                </a>

            </div>

        </aside>


        <!-- =====================================================
             Main Content
        ====================================================== -->

        <main class="user-main">

            <div class="user-main-inner">


                <!-- Top Bar -->

                <div class="user-topbar">

                    <div>

                        <h1 class="user-page-title">
                            @(ViewData["Title"] ?? "داشبورد")
                        </h1>

                        <p class="user-page-subtitle">
                            مدیریت حساب کاربری و فعالیت‌های شما در آکادمی آرایان
                        </p>

                    </div>


                    <a href="/"
                       class="site-link">

                        <i class="fas fa-arrow-right"></i>

                        <span>
                            بازگشت به سایت
                        </span>

                    </a>

                </div>


                <!-- Page Content -->
                @RenderBody()


            </div>

        </main>

    </div>


    <!-- =========================================================
         Scripts
    ========================================================== -->

    <script src="/assets/js/vendor/jquery-3.6.0.min.js"></script>

    <script src="/assets/js/bootstrap.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/persian-date@1.1.0/dist/persian-date.min.js"></script>


    <script>

        $(function () {

            const sidebar = $('#userSidebar');
            const overlay = $('#userSidebarOverlay');
            const toggle = $('#userMenuToggle');

            function openSidebar() {

                sidebar.addClass('show');
                overlay.addClass('show');

                $('body').css('overflow', 'hidden');

            }


            function closeSidebar() {

                sidebar.removeClass('show');
                overlay.removeClass('show');

                $('body').css('overflow', '');

            }


            toggle.on('click', function () {

                if (sidebar.hasClass('show')) {

                    closeSidebar();

                } else {

                    openSidebar();

                }

            });


            overlay.on('click', function () {

                closeSidebar();

            });


            $('.user-nav-link').on('click', function () {

                if (window.innerWidth <= 991) {

                    closeSidebar();

                }

            });


            $(window).on('resize', function () {

                if (window.innerWidth > 991) {

                    closeSidebar();

                }

            });

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

