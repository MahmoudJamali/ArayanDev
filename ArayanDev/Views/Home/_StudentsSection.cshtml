@using Business.Handlers.Users.Queries
@model HomeStudentsViewModel

<style>

    /* =========================================
           Students Carousel
           ========================================= */

    .students-carousel {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .students-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        width: 100%;
    }

    /*
           فقط 4 کارت نمایش داده می‌شوند.
           بقیه توسط JavaScript مخفی هستند.
        */

    .student-slide {
        display: none;
        min-width: 0;
    }

        .student-slide.active {
            display: block;
            animation: studentFadeIn .6s ease forwards;
        }


    /* =========================================
           Student Card
           ========================================= */

    .student-card {
        width: 100%;
        background: rgba(15, 20, 35, .72);
        border: 1px solid rgba(0, 240, 255, .12);
        border-radius: 18px;
        padding: 22px 15px;
        text-align: center;
        min-height: 230px;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease;
    }

        .student-card:hover {
            transform: translateY(-7px);
            border-color: rgba(0, 240, 255, .45);
            box-shadow: 0 10px 35px rgba(0, 240, 255, .08), 0 0 30px rgba(255, 0, 212, .05);
        }


        /* =========================================
           Decorative Light
           ========================================= */

        .student-card::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            top: -45px;
            left: -45px;
            background: radial-gradient( circle, rgba(0, 240, 255, .18), transparent 70% );
            pointer-events: none;
        }

        .student-card::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            bottom: -50px;
            right: -50px;
            background: radial-gradient( circle, rgba(255, 0, 212, .16), transparent 70% );
            pointer-events: none;
        }


    /* =========================================
           Profile Image
           ========================================= */

    .student-img {
        width: 105px;
        height: 105px;
        object-fit: cover;
        border-radius: 50%;
        display: block;
        margin: 0 auto 15px;
        border: 3px solid rgba(0, 240, 255, .65);
        box-shadow: 0 0 0 4px rgba(0, 240, 255, .06), 0 0 25px rgba(0, 240, 255, .12);
        position: relative;
        z-index: 2;
    }


    /* =========================================
           Name
           ========================================= */

    .student-name {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 6px;
        position: relative;
        z-index: 2;
    }


    .student-title {
        color: rgba(255, 255, 255, .55);
        font-size: 12px;
        position: relative;
        z-index: 2;
    }


    /* =========================================
           Status Dot
           ========================================= */

    .student-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #00f0ff;
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 3;
        animation: studentPulse 1.8s infinite;
    }


    /* =========================================
           Animation
           ========================================= */

    @@keyframes studentFadeIn {

        from {
            opacity: 0;
            transform: translateY(15px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    @@keyframes studentPulse {

        0% {
            box-shadow: 0 0 0 0 rgba(0, 240, 255, .45);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(0, 240, 255, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(0, 240, 255, 0);
        }
    }


    /* =========================================
           Mobile
           ========================================= */

    @@media (max-width: 576px) {

        .students-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
        }

        .student-card {
            min-height: 185px;
            padding: 15px 5px;
            border-radius: 14px;
        }

        .student-img {
            width: 65px;
            height: 65px;
            margin-bottom: 10px;
        }

        .student-name {
            font-size: 11px;
        }

        .student-title {
            font-size: 8px;
        }

        .student-dot {
            width: 7px;
            height: 7px;
            top: 10px;
            right: 10px;
        }
    }

</style>


@if (Model?.Students != null && Model.Students.Any())
{
    <div class="students-carousel">

        <div class="students-grid" id="studentsGrid">

            @foreach (var item in Model.Students)
            {
                <div class="student-slide">

                    <div class="student-card">

                        <div class="student-dot"></div>

                        <img class="student-img"
                             src="@(string.IsNullOrWhiteSpace(item.ProfileImage)
                                      ? "/uploads/profile/SocialLogo.png"
                                      : item.ProfileImage)"
                             alt="@($"{item.Name} {item.Family}")"
                             onerror="this.onerror=null;this.src='/uploads/profile/SocialLogo.png';" />

                        <div class="student-name">
                            @item.Name @item.Family
                        </div>

                        <div class="student-title">
                            برنامه‌نویسی و طراحی سایت
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
}
else
{
    <div class="students-empty">
        دانشجویی برای نمایش وجود ندارد.
    </div>
}